// =================  Average Daily Range
groupADR = "- - - - - - - - - - - Average Daily Range (ADR) - - - - - - - - - - - "

// Master control (this should be defined elsewhere in your code)
// Table display settings
adrTablePosition = input.string("bottom_right", title="ADR Table Position", options=["top_left", "top_center", "top_right", "middle_left", "middle_center", "middle_right", "bottom_left", "bottom_center", "bottom_right"], group=groupADR, display=display.none)
