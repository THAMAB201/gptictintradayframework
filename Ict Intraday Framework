// ============================= Unfilled Liquidity
// --- Toggle ---
ULVgroup_void = "Unfilled Liquidity Voids"
// --- INPUTS ---
ULVboxlength = input.int(title="Box Length", defval=1, minval=1, maxval=10, group=ULVgroup_void, display=display.none)
ULVc_up = input.color(color.rgb(84, 17, 193, 84), "Up Void Color", group=ULVgroup_void, display=display.none)
ULVc_down = input.color(color.rgb(84, 17, 193, 84), "Down Void Color", group=ULVgroup_void, display=display.none)

// --- TIME INPUTS (STATIC) ---
ULVstart_hour_input = 9
ULVstart_minute_input = 31
ULVend_hour_input = 15
ULVend_minute_input = 0
ULVny_timezone = "America/New_York"

// --- FUNCTION DECLARATION ---
// This function checks if a void is filled.
ULVisFilled(ULVlow_check, ULVhigh_check, ULVtop_price, ULVbottom_price) =>
    ULVlow_check <= ULVtop_price and ULVhigh_check >= ULVbottom_price

// --- LOGIC AND DRAWING ---
if showUnfilledLiquidity
    ULVcurrent_hour = hour(time, ULVny_timezone)
    ULVcurrent_minute = minute(time, ULVny_timezone)

    bool ULVin_session = (ULVcurrent_hour > ULVstart_hour_input or (ULVcurrent_hour == ULVstart_hour_input and ULVcurrent_minute >= ULVstart_minute_input)) and
                         (ULVcurrent_hour < ULVend_hour_input or (ULVcurrent_hour == ULVend_hour_input and ULVcurrent_minute <= ULVend_minute_input))

    // --- UNFILLED VOID TRACKING ---
    var box[] ULVupVoids = array.new_box()
    var float[] ULVupVoidsTop = array.new<float>()
    var float[] ULVupVoidsBottom = array.new<float>()

    var box[] ULVdownVoids = array.new<box>()
    var float[] ULVdownVoidsTop = array.new<float>()
    var float[] ULVdownVoidsBottom = array.new<float>()

    // Loop through upward voids to check if they've been filled
    if array.size(ULVupVoids) > 0
        for ULV_i = array.size(ULVupVoids) - 1 to 0
            ULVbox_id = array.get(ULVupVoids, ULV_i)
            ULVbox_top = array.get(ULVupVoidsTop, ULV_i)
            ULVbox_bottom = array.get(ULVupVoidsBottom, ULV_i)
            if ULVisFilled(low, high, ULVbox_top, ULVbox_bottom)
                box.delete(ULVbox_id)
                array.remove(ULVupVoids, ULV_i)
                array.remove(ULVupVoidsTop, ULV_i)
                array.remove(ULVupVoidsBottom, ULV_i)

    // Loop through downward voids to check if they've been filled
    if array.size(ULVdownVoids) > 0
        for ULV_i = array.size(ULVdownVoids) - 1 to 0
            ULVbox_id = array.get(ULVdownVoids, ULV_i)
            ULVbox_top = array.get(ULVdownVoidsTop, ULV_i)
            ULVbox_bottom = array.get(ULVdownVoidsBottom, ULV_i)
            if ULVisFilled(low, high, ULVbox_top, ULVbox_bottom)
                box.delete(ULVbox_id)
                array.remove(ULVdownVoids, ULV_i)
                array.remove(ULVdownVoidsTop, ULV_i)
                array.remove(ULVdownVoidsBottom, ULV_i)

    // --- DRAWING LOGIC ---
    // Check for new upward voids (gaps up)
    bool ULVisUpVoid = close[1] < open
    if ULVisUpVoid and ULVin_session
        // Add new void to arrays and draw box
        ULVbox_id = box.new(
             left=bar_index[1],
             top=open,
             right=bar_index + ULVboxlength,
             bottom=close[1],
             bgcolor=ULVc_up,
             border_color=ULVc_up
             )
        array.push(ULVupVoids, ULVbox_id)
        array.push(ULVupVoidsTop, open)
        array.push(ULVupVoidsBottom, close[1])

    // Check for new downward voids (gaps down)
    bool ULVisDownVoid = close[1] > open
    if ULVisDownVoid and ULVin_session
        // Add new void to arrays and draw box
        ULVbox_id = box.new(
             left=bar_index[1],
             top=close[1],
             right=bar_index + ULVboxlength,
             bottom=open,
             bgcolor=ULVc_down,
             border_color=ULVc_down
             )
        array.push(ULVdownVoids, ULVbox_id)
        array.push(ULVdownVoidsTop, close[1])
        array.push(ULVdownVoidsBottom, open)
